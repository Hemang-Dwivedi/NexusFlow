<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:uiViews="clr-namespace:NexusFlow.UI.Views;assembly=NexusFlow.UI"
        xmlns:uiVm="clr-namespace:NexusFlow.UI.ViewModels;assembly=NexusFlow.UI"
        x:Class="NexusFlow.App.Views.MainWindow"
        x:DataType="uiVm:MainViewModel"
        Width="1200" Height="750"
        Title="NexusFlow">

  <TabControl HorizontalContentAlignment="Stretch"
            VerticalContentAlignment="Stretch">
  <TabItem Header="Layout">
    <uiViews:LayoutEditorView DataContext="{Binding Layout}" />
  </TabItem>

  <TabItem Header="Peers">
    <uiViews:PeersListView DataContext="{Binding Peers}" />
  </TabItem>
  <TabItem>
    <uiViews:DiagnosticsView DataContext="{Binding Diagnostics}" />
  </TabItem>
</TabControl>

</Window>
