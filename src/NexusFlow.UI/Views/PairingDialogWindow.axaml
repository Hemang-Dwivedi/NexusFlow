<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:NexusFlow.UI.ViewModels"
        x:Class="NexusFlow.UI.Views.PairingDialogWindow"
        x:DataType="vm:PairingDialogViewModel"
        Width="420" Height="240"
        CanResize="False"
        Title="{Binding Title}">

  <Grid Margin="16" RowDefinitions="Auto,Auto,Auto,*" RowSpacing="12">
    <TextBlock Text="{Binding RemoteDeviceName}" FontSize="16" FontWeight="SemiBold"/>

    <Border Grid.Row="1" CornerRadius="8" Padding="12"
            BorderBrush="{DynamicResource ThemeBorderLowBrush}" BorderThickness="1">
      <TextBlock Text="{Binding Code}"
                 FontSize="32"
                 FontWeight="Bold"
                 HorizontalAlignment="Center" />
    </Border>

    <TextBlock Grid.Row="2" Text="{Binding HintText}" Opacity="0.8" TextWrapping="Wrap"/>

    <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="10">
      <Button Content="Reject" Command="{Binding RejectCommand}" />
      <Button Content="Accept" Command="{Binding AcceptCommand}" />
    </StackPanel>
  </Grid>
</Window>
