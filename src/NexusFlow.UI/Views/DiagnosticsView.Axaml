<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="NexusFlow.UI.Views.DiagnosticsView">
  <StackPanel Spacing="12" Margin="16">

    <TextBlock FontSize="18" Text="Diagnostics" />

    <Border Padding="12" CornerRadius="8">
      <StackPanel Spacing="6">
        <TextBlock Text="Routing State" FontSize="16"/>
        <TextBlock Text="{Binding ActiveTargetPeerId, StringFormat=Active Target: {0}}" />
        <TextBlock Text="{Binding ActiveSourcePeerId, StringFormat=Active Source: {0}}" />
      </StackPanel>
    </Border>

    <Border Padding="12" CornerRadius="8">
      <StackPanel Spacing="8">
        <TextBlock Text="Failsafe (local-only)" FontSize="16"/>
        <TextBlock Text="{Binding IsFailsafeBlocked, StringFormat=Blocked: {0}}" />
        <Button Content="Toggle Failsafe" Command="{Binding ToggleFailsafeCommand}" />
      </StackPanel>
    </Border>
      <Border Padding="12" CornerRadius="8">
  <StackPanel Spacing="8">
    <TextBlock Text="Input Source Switching Simulator" FontSize="16"/>
    <TextBlock Text="{Binding InputThresholdInfo}" Opacity="0.7"/>

    <TextBlock Text="Simulate input coming from:" />
    <ComboBox ItemsSource="{Binding Peers.ConnectedPeers}"
              SelectedItem="{Binding SelectedSimPeerItem, Mode=TwoWay}" />

    <WrapPanel>
      <Button Content="Key Press" Command="{Binding SimKeyPressCommand}" />
      <Button Content="Mouse Click" Command="{Binding SimMouseClickCommand}" />
      <Button Content="Mouse Scroll" Command="{Binding SimMouseScrollCommand}" />
      <Button Content="Mic Activity" Command="{Binding SimMicActivityCommand}" />
    </WrapPanel>

    <TextBlock Text="Mouse Move (dx, dy) — switches only after threshold" Opacity="0.8"/>
    <WrapPanel VerticalAlignment="Center">
      <TextBlock Text="dx:" VerticalAlignment="Center"/>
      <TextBox Width="80" Text="{Binding MoveDx, Mode=TwoWay}" />
      <TextBlock Text="dy:" VerticalAlignment="Center"/>
      <TextBox Width="80" Text="{Binding MoveDy, Mode=TwoWay}" />
      <Button Content="Mouse Move" Command="{Binding SimMouseMoveCommand}" />
    </WrapPanel>
  </StackPanel>
</Border>
      <Border Padding="12" CornerRadius="8">
  <StackPanel Spacing="8">
    <TextBlock Text="Modifier State Model (simulated)" FontSize="16"/>
    <TextBlock Text="{Binding ModifierStateText, StringFormat=Current: {0}}" Opacity="0.8"/>

    <TextBlock Text="Simulate key events from:" />
    <ComboBox ItemsSource="{Binding Peers.ConnectedPeers}"
              SelectedItem="{Binding SelectedKeyPeerItem, Mode=TwoWay}" />

    <TextBlock Text="Key:" />
    <ComboBox ItemsSource="{Binding KeyOptions}"
              SelectedItem="{Binding SelectedKey, Mode=TwoWay}" />

    <WrapPanel>
      <Button Content="Key Down" Command="{Binding SimKeyDownCommand}" />
      <Button Content="Key Up" Command="{Binding SimKeyUpCommand}" />
      <Button Content="Reset Modifiers" Command="{Binding ResetModifiersCommand}" />
    </WrapPanel>

    <TextBlock Text="Rule: Key Down also switches ActiveSource immediately."
               Opacity="0.7" TextWrapping="Wrap"/>
  </StackPanel>
</Border>


    <Border Padding="12" CornerRadius="8">
      <StackPanel Spacing="8">
        <TextBlock Text="Manual Switch (temporary)" FontSize="16"/>

        <TextBlock Text="Target" />
        <ComboBox ItemsSource="{Binding Peers.ConnectedPeers}"
                  SelectedItem="{Binding SelectedTargetItem, Mode=TwoWay}" />
        <Button Content="Set Target" Command="{Binding SetTargetCommand}" />

        <TextBlock Text="Source" Margin="0,8,0,0"/>
        <ComboBox ItemsSource="{Binding Peers.ConnectedPeers}"
                  SelectedItem="{Binding SelectedSourceItem, Mode=TwoWay}"/>
        <Button Content="Set Source" Command="{Binding SetSourceCommand}" />

        <Button Content="Set Both = Self" Command="{Binding SetSelfCommand}" Margin="0,8,0,0"/>
      </StackPanel>
    </Border>

    <Border Padding="12" CornerRadius="8">
      <StackPanel Spacing="8">
        <TextBlock Text="Event Log (latest at bottom)" FontSize="16"/>
        <ScrollViewer Height="220">
          <ItemsControl ItemsSource="{Binding Logs}">
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <TextBlock>
                    <Run Text="[" />
                    <Run Text="{Binding Timestamp, StringFormat={}{0:HH:mm:ss}}" />
                    <Run Text="] " />
                    <Run Text="{Binding Level}" />
                    <Run Text=" " />
                    <Run Text="{Binding Category}" />
                    <Run Text=": " />
                    <Run Text="{Binding Message}" />
                  </TextBlock>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
      </StackPanel>
    </Border>

  </StackPanel>
</UserControl>
