<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:NexusFlow.UI.ViewModels;assembly=NexusFlow.UI"
             x:Class="NexusFlow.UI.Views.LayoutEditorView"
             x:DataType="vm:LayoutEditorViewModel">

  <UserControl.Resources>
    <SolidColorBrush x:Key="Bg"         Color="#0E0F12"/>
    <SolidColorBrush x:Key="Card"       Color="#16181D"/>
    <SolidColorBrush x:Key="Stroke"     Color="#2C313C"/>
    <SolidColorBrush x:Key="StrokeSoft" Color="#232832"/>
    <SolidColorBrush x:Key="Text"       Color="#E7EAF0"/>
    <SolidColorBrush x:Key="TextDim"    Color="#A6AFBF"/>
    <SolidColorBrush x:Key="Accent"     Color="#3B82F6"/>
    <SolidColorBrush x:Key="Accent2"    Color="#2563EB"/>
    <SolidColorBrush x:Key="CanvasBg"   Color="#0A0C10"/>
  </UserControl.Resources>

  <UserControl.Styles>
    <Style Selector="Button.layoutBtn">
      <Setter Property="Background"      Value="#1C1F26"/>
      <Setter Property="BorderBrush"     Value="{StaticResource Stroke}"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="CornerRadius"    Value="8"/>
      <Setter Property="Padding"         Value="12,8"/>
      <Setter Property="Foreground"      Value="{StaticResource Text}"/>
    </Style>
    <Style Selector="Button.layoutBtn:disabled">
      <Setter Property="Opacity" Value="0.4"/>
    </Style>
    <Style Selector="Button.primaryBtn">
      <Setter Property="Background"  Value="{StaticResource Accent2}"/>
      <Setter Property="BorderBrush" Value="{StaticResource Accent}"/>
      <Setter Property="Foreground"  Value="White"/>
    </Style>

    <!-- Base display tile -->
    <Style Selector="Border.displayTile">
      <Setter Property="Background"      Value="#1E2538"/>
      <Setter Property="BorderBrush"     Value="#3A4A65"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="CornerRadius"    Value="6"/>
      <Setter Property="Cursor"          Value="SizeAll"/>
    </Style>
    <!-- Local tiles: blue tint, draggable like remote tiles -->
    <Style Selector="Border.displayTile.localTile">
      <Setter Property="Background"  Value="#0D1E3A"/>
      <Setter Property="BorderBrush" Value="#1A4070"/>
    </Style>
    <!-- Active routing target highlight -->
    <Style Selector="Border.displayTile.activeTarget">
      <Setter Property="BorderBrush"     Value="#3B82F6"/>
      <Setter Property="BorderThickness" Value="2"/>
      <Setter Property="BoxShadow"       Value="0 0 12 3 #3B82F6"/>
    </Style>
  </UserControl.Styles>

  <Border Background="{StaticResource Bg}" Padding="16">
    <Grid RowDefinitions="Auto,*" RowSpacing="12">

      <!-- Header -->
      <Border Grid.Row="0"
              Background="{StaticResource Card}"
              BorderBrush="{StaticResource Stroke}"
              BorderThickness="1" CornerRadius="12" Padding="14">
        <DockPanel LastChildFill="True">

          <StackPanel DockPanel.Dock="Left" Spacing="2">
            <TextBlock Text="Display Layout"
                       Foreground="{StaticResource Text}"
                       FontSize="18" FontWeight="SemiBold"/>
            <TextBlock Text="Drag any tile to arrange your layout. Tiles snap together. Apply to save and sync."
                       Foreground="{StaticResource TextDim}" FontSize="12"/>
          </StackPanel>

          <!-- Routing state pill -->
          <Border DockPanel.Dock="Right" Margin="0,0,8,0"
                  Background="#1E3A5F"
                  BorderBrush="{StaticResource Accent}"
                  BorderThickness="1" CornerRadius="20" Padding="12,4">
            <StackPanel Orientation="Horizontal" Spacing="6">
              <Ellipse Width="8" Height="8" Fill="#3B82F6"/>
              <TextBlock Text="{Binding ActiveTargetName}"
                         Foreground="{StaticResource Accent}"
                         FontSize="12" FontWeight="Medium"
                         VerticalAlignment="Center"/>
            </StackPanel>
          </Border>

          <!-- Action buttons -->
          <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="8">
            <Button Classes="layoutBtn" Content="Revert"
                    Command="{Binding RevertCommand}" IsEnabled="{Binding IsDirty}" Width="100"/>
            <Button Classes="layoutBtn primaryBtn" Content="Apply"
                    Command="{Binding ApplyCommand}" IsEnabled="{Binding IsDirty}" Width="100"/>
          </StackPanel>

        </DockPanel>
      </Border>

      <!-- Canvas workspace -->
      <Border Grid.Row="1"
              Background="{StaticResource Card}"
              BorderBrush="{StaticResource Stroke}"
              BorderThickness="1" CornerRadius="12" Padding="12">
        <Border Background="{StaticResource CanvasBg}"
                BorderBrush="{StaticResource StrokeSoft}"
                BorderThickness="1" CornerRadius="10">

          <ScrollViewer HorizontalScrollBarVisibility="Auto"
                        VerticalScrollBarVisibility="Auto">

            <!-- Fixed-size canvas -->
            <Grid Width="{Binding WorkspaceWidth}" Height="{Binding WorkspaceHeight}">

              <!-- Layer 1: peer name labels (behind tiles) -->
              <ItemsControl ItemsSource="{Binding PeerGroups}">
                <ItemsControl.ItemsPanel>
                  <ItemsPanelTemplate><Canvas/></ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <!-- Position the ContentPresenter directly — guaranteed Canvas layout -->
                <ItemsControl.ItemContainerTheme>
                  <ControlTheme TargetType="ContentPresenter">
                    <Setter Property="Canvas.Left" Value="{Binding LabelX}"/>
                    <Setter Property="Canvas.Top"  Value="{Binding LabelY}"/>
                  </ControlTheme>
                </ItemsControl.ItemContainerTheme>
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="vm:PeerGroupVm">
                    <Border Width="{Binding LabelWidth}">
                      <TextBlock Text="{Binding PeerName}"
                                 HorizontalAlignment="Center"
                                 TextAlignment="Center"
                                 FontSize="11" FontWeight="Medium"
                                 Foreground="#A6AFBF"/>
                    </Border>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>

              <!-- Layer 2: display tiles (interactive, on top) -->
              <ItemsControl ItemsSource="{Binding DisplayTiles}">
                <ItemsControl.ItemsPanel>
                  <ItemsPanelTemplate><Canvas/></ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <!-- Position the ContentPresenter directly — guaranteed Canvas layout -->
                <ItemsControl.ItemContainerTheme>
                  <ControlTheme TargetType="ContentPresenter">
                    <Setter Property="Canvas.Left" Value="{Binding Nx}"/>
                    <Setter Property="Canvas.Top"  Value="{Binding Ny}"/>
                  </ControlTheme>
                </ItemsControl.ItemContainerTheme>
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="vm:DisplayTileVm">
                    <Border Classes="displayTile"
                            Classes.localTile="{Binding IsLocal}"
                            Classes.activeTarget="{Binding IsActiveTarget}"
                            Width="{Binding Nw}"
                            Height="{Binding Nh}"
                            PointerPressed="TilePointerPressed"
                            PointerMoved="TilePointerMoved"
                            PointerReleased="TilePointerReleased">
                      <Grid RowDefinitions="*,Auto">
                        <!-- Display number (center) -->
                        <TextBlock Grid.Row="0"
                                   Text="{Binding DisplayNumber}"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   FontSize="22" FontWeight="Bold"
                                   Foreground="White"/>
                        <!-- Peer/device label (bottom strip for remote tiles) -->
                        <Border Grid.Row="1"
                                Background="#00000040"
                                Padding="4,2"
                                IsVisible="{Binding !IsLocal}">
                          <TextBlock Text="{Binding PeerName}"
                                     HorizontalAlignment="Center"
                                     FontSize="9"
                                     Foreground="#A6AFBF"
                                     TextTrimming="CharacterEllipsis"/>
                        </Border>
                      </Grid>
                    </Border>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>

            </Grid>
          </ScrollViewer>
        </Border>
      </Border>

    </Grid>
  </Border>
</UserControl>
