<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="NexusFlow.UI.Views.LayoutEditorView">

  <Border Background="#111" Padding="16">
    <Border Background="#1E1E1E"
            BorderBrush="#444"
            BorderThickness="1"
            CornerRadius="10"
            Padding="12">

      <StackPanel Spacing="12">

        <!-- Command bar -->
        <StackPanel Orientation="Horizontal" Spacing="8">
          <Button Content="Revert"
                  Command="{Binding RevertCommand}"
                  IsEnabled="{Binding IsDirty}"
                  Width="90" />

          <Button Content="Apply"
                  Command="{Binding ApplyCommand}"
                  IsEnabled="{Binding IsDirty}"
                  Width="90" />
        </StackPanel>

        <!-- Layout canvas -->
        <Border Background="#0B0B0B"
                BorderBrush="#333"
                BorderThickness="1"
                CornerRadius="8"
                Padding="8">

          <Border Width="{Binding CanvasWidth}"
                  Height="{Binding CanvasHeight}"
                  HorizontalAlignment="Left"
                  VerticalAlignment="Top"
                  Background="Transparent">

            <ItemsControl ItemsSource="{Binding PeerBlocks}"
                          Width="{Binding CanvasWidth}"
                          Height="{Binding CanvasHeight}">

              <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                  <Canvas Width="{Binding CanvasWidth}"
                          Height="{Binding CanvasHeight}" />
                </ItemsPanelTemplate>
              </ItemsControl.ItemsPanel>

              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <!-- One peer "desktop bounds" rectangle -->
                  <Border Width="{Binding Nw}"
                          Height="{Binding Nh}"
                          Background="#202020"
                          BorderBrush="#777"
                          BorderThickness="1"
                          CornerRadius="8"
                          PointerPressed="PeerPointerPressed"
                          PointerMoved="PeerPointerMoved"
                          PointerReleased="PeerPointerReleased">

                    <Border.RenderTransform>
                      <TranslateTransform X="{Binding Nx}"
                                          Y="{Binding Ny}" />
                    </Border.RenderTransform>

                    <TextBlock Text="{Binding PeerName}"
                               Foreground="White"
                               FontSize="14"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center" />
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>

            </ItemsControl>
          </Border>
        </Border>

      </StackPanel>
    </Border>
  </Border>
</UserControl>
