<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:NexusFlow.UI.ViewModels"
             xmlns:dg="clr-namespace:Avalonia.Controls;assembly=Avalonia.Controls.DataGrid"
             x:Class="NexusFlow.UI.Views.PeersListView"
             x:DataType="vm:PeersListViewModel">

  <Grid RowDefinitions="Auto,*"
        Margin="16"
        RowSpacing="12"
        VerticalAlignment="Stretch"
        HorizontalAlignment="Stretch">

    <TextBlock Text="Discovered Peers"
               FontSize="18"
               FontWeight="SemiBold"/>

    <Border Grid.Row="1"
            VerticalAlignment="Stretch"
            HorizontalAlignment="Stretch"
            CornerRadius="8"
            BorderThickness="1"
            BorderBrush="{DynamicResource ThemeBorderLowBrush}"
            Padding="12">

      <Grid RowDefinitions="Auto,*"
            RowSpacing="10"
            VerticalAlignment="Stretch"
            HorizontalAlignment="Stretch">
        <dg:DataGrid Grid.Row="1"
             ItemsSource="{Binding Peers}"
             AutoGenerateColumns="False"
             MinHeight="100"
             Background="#202020"
             Foreground="White"
             BorderBrush="#202021"
             BorderThickness="2"
             GridLinesVisibility="All"
             HeadersVisibility="Column"
             IsReadOnly="True">

  <dg:DataGrid.Columns>

    <!-- Device name -->
    <dg:DataGridTextColumn Header="Device"
                           Binding="{Binding DeviceName}"
                           Width="2*" />

    <!-- Short Peer ID -->
    <dg:DataGridTextColumn Header="Peer ID"
                           Binding="{Binding PeerIdShort}"
                           Width="*" />

    <!-- TCP port -->
    <dg:DataGridTextColumn Header="TCP"
                           Binding="{Binding TcpPort}"
                           Width="*" />

    <!-- Action button -->
    <dg:DataGridTemplateColumn Header="Action"
                               Width="*">
      <dg:DataGridTemplateColumn.CellTemplate>
        <DataTemplate x:DataType="vm:PeerRowViewModel">
          <Button Content="Pair"
                  Padding="6,2"
                  Command="{Binding DataContext.PairCommand,
                                    RelativeSource={RelativeSource AncestorType=UserControl}}"
                  CommandParameter="{Binding}" />
        </DataTemplate>
      </dg:DataGridTemplateColumn.CellTemplate>
    </dg:DataGridTemplateColumn>

  </dg:DataGrid.Columns>
</dg:DataGrid>

      </Grid>

    </Border>
  </Grid>
</UserControl>
