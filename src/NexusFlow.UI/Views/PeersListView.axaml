<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:NexusFlow.UI.ViewModels"
             xmlns:dg="clr-namespace:Avalonia.Controls;assembly=Avalonia.Controls.DataGrid"
             x:Class="NexusFlow.UI.Views.PeersListView"
             x:DataType="vm:PeersListViewModel">


    <Grid RowDefinitions="Auto,*" Margin="16" RowSpacing="12">
        <TextBlock
            Text="Discovered Peers"
            FontSize="18"
            FontWeight="SemiBold"/>

        <Border Grid.Row="1"
                CornerRadius="8"
                BorderThickness="1"
                BorderBrush="{DynamicResource ThemeBorderLowBrush}"
                Padding="12">

            <Grid RowDefinitions="Auto,*" RowSpacing="10">

                <TextBlock
                    Text="No peers discovered yet (LAN UDP broadcast)."
                    IsVisible="{Binding !HasPeers}" />

                <dg:DataGrid
                    Grid.Row="1"
                    IsVisible="{Binding HasPeers}"
                    ItemsSource="{Binding Peers}"
                    AutoGenerateColumns="False"
                    CanUserReorderColumns="False"
                    CanUserResizeColumns="True"
                    GridLinesVisibility="None"
                    HeadersVisibility="Column">

                    <dg:DataGrid.Columns>
                        <dg:DataGridTextColumn
                            Header="Device"
                            Binding="{Binding DeviceName}"
                            Width="2*" />

                        <dg:DataGridTextColumn
                            Header="PeerId"
                            Binding="{Binding PeerIdShort}"
                            Width="*" />

                        <dg:DataGridTextColumn
                            Header="TCP Port"
                            Binding="{Binding TcpPort}"
                            Width="*" />

                        <dg:DataGridTextColumn
                            Header="Last Seen (UTC)"
                            Binding="{Binding LastSeen}"
                            Width="2*" />
                    </dg:DataGrid.Columns>

                </dg:DataGrid>
            </Grid>
        </Border>
    </Grid>
</UserControl>
